[builtins fixtures/list.pyi]
[out]
main:4: note: Type "Alias" does not contain Any

[case testRevealAnySourceGenericCallsAcrossModules]
from source import load
from service import forward, relay
x = forward(relay(load()))
reveal_any_source(x)
[file source.py]
from typing import Any
def load() -> Any: ...
[file service.py]
from typing import TypeVar
T = TypeVar('T')
def forward(value: T) -> T:
    return value
def relay(value: T) -> T:
    return value
[out]
main:4: note: Any comes from explicit 'Any' in return type of "load" (tmp/source.py:2)
main:4: note:   -> returned by "load()" (line 3)
main:4: note:   -> returned by "relay(...)" (line 3)
main:4: note:   -> returned by "forward(...)" (line 3)
main:4: note:   -> assigned to "x" (line 3)

