[case testRevealAnySourceIndependentBranches]
from typing import Any
def first() -> Any: ...
def second(): ...
flag: bool
x = first()
if flag:
    x = second()
else:
    reveal_any_source(x)
[out]
main:9: note: Any comes from explicit 'Any' in return type of "first" (line 2)
main:9: note:   -> returned by "first()" (line 5)
main:9: note:   -> assigned to "x" (line 5)

[case testRevealAnySourceBranchReplacementIncremental]
from util import x
reveal_any_source(x)
[file util.py]
from typing import Any
def first() -> Any: ...
def second(): ...
flag: bool
x = first()
x = first()
if flag:
    x = second()
else:
    x = second()
[out]
main:2: note: Any comes from missing return annotation of "second" (tmp/util.py:3)
main:2: note:   -> returned by "second()" (tmp/util.py:8)
main:2: note:   -> assigned to "x" (tmp/util.py:8)
[out2]
main:2: note: Any comes from missing return annotation of "second" (tmp/util.py:3)
main:2: note:   -> returned by "second()" (tmp/util.py:8)
main:2: note:   -> assigned to "x" (tmp/util.py:8)
